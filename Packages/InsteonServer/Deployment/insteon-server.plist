<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- A user agent: install in ~/Library/LaunchAgents/. It runs as you, so it reads
       ~/.config/insteon/env. The file holds the passwords; this one holds none. -->
  <key>Label</key>
  <string>local.insteon-server</string>

  <!-- Replace YOU with your user name. Add "--listen", "100.100.20.30" for a VPN address. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/.local/bin/insteon-server</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart the process whenever it exits, after at least 10 seconds. The server stays up
       while the Hub is away, so a restart means a crash or a configuration error. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <!-- launchd doesn't expand ~ here. The log holds connection notes, never a password. -->
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/insteon-server.log</string>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/insteon-server.log</string>
</dict>
</plist>
